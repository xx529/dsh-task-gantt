{
  "name": "dsh-task-gantt",
  "version": "0.2.38",
  "description": "Agent-team task Gantt chart for the DSH sidebar \u2014 teammates on the y-axis, real session time on the x-axis, task title and summary in every bar. \u00b7 DSH \u4fa7\u8fb9\u680f\u7684 agent team \u4efb\u52a1\u7518\u7279\u56fe\u3002",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/xx529/dsh-task-gantt"
  },
  "homepage": "https://github.com/xx529/dsh-task-gantt#readme",
  "bugs": {
    "url": "https://github.com/xx529/dsh-task-gantt/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-better-sidebar",
    "agent-team",
    "gantt"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "docs/INSTALL.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:meta": "node scripts/verify-meta.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify:build && pnpm run verify:meta && git diff --exit-code HEAD -- lib",
    "pack:check": "pnpm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
